# Local development
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PythonAnywhere production
# Example: PYTHONANYWHERE_DOMAIN=yourusername.pythonanywhere.com
PYTHONANYWHERE_DOMAIN=
# Or set CSRF_TRUSTED_ORIGINS explicitly:
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# Optional database URL. Leave blank to use SQLite.
DATABASE_URL=

# Password reset email. The console backend is safe for local development only.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
